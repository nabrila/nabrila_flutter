  },
  "fixedInCases": {
    "description": "fixedIn: a pubspec version (1 to 4 numbers, optional +build) or a build number alone (37 or +37), at most 40 characters. Web (isFixedIn) and SDK (isFixedIn) must agree.",
    "valid": [
      "1",
      "1.4",
      "1.4.2",
      "1.4.2+37",
      "1.4.2.9",
      "+37",
      "37",
      "999999.0.0+123456789"
    ],
    "invalid": [
      "",
      "v1.4",
      "1.4.2-beta",
      "1..2",
      "1.4.2+",
      "next",
      "1.2.3.4.5",
      "11111111111111111111111111111111111111111",
      " 1.4.2",
      "1.4.2 ",
      "+",
      "1.4.2+37+1",
      "1234567.0"
    ]
  },
